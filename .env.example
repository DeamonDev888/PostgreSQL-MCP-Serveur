# Financial Analyst - Environment Configuration
# Enable database
USE_DATABASE=true

# PostgreSQL Configuration (compatible avec Financial Analyst)
POSTGRES_HOST=localhost
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Alternative: Use full connection string

# Additional PostgreSQL Settings
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT=30000

# Environment
NODE_ENV=development

# Optional: Connection String (overrides individual settings)


# OpenRouter Configuration (Qwen3 Embedding 8B)
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_PROVIDER=openrouter
EMBEDDING_DIMENSIONS=4096
EMBEDDING_CACHE_SIZE=1000
